# Copy to .env.local for local work; set the same four in Vercel for the real
# thing. Never commit the filled-in version — .gitignore already refuses it.

# Postgres connection string from Neon, Supabase or Vercel Postgres.
DATABASE_URL=

# Any long random string. Changing it signs everybody out immediately, which
# is the fastest way to cut off access if a laptop goes missing.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The shared key the bots and Zapier send as the x-bot-key header. Generate it
# the same way. This is the only thing between the internet and writing to the
# board, so treat it as a password: rotate it if it is ever pasted into a
# chat, an email, or a Zap somebody else can open.
BOT_API_KEY=

# The office logins, as JSON. Never a plain password — only scrypt hashes from
#   npm run hash -- "the password"
# Give each person their own entry so the board can show who approved what.
# [{"user":"kristofer","name":"Kristofer","hash":"<salt>:<key>"}]
OFFICE_USERS=[]

# Only if your Postgres provider uses a private certificate authority: paste
# its root certificate here. Do NOT switch verification off instead.
# DATABASE_CA=

# Last resort, and it means "accept any certificate": set to 1 only to prove a
# TLS problem is the cause of something, then unset it.
# DATABASE_SSL_NO_VERIFY=
